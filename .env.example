# ==============================================================================
# AI ISP OS - Backend Environment Configuration (Template)
# Copy this file to .env and replace placeholder values with your environment settings
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
CWMP_PORT=7547
APP_URL=http://localhost:4000
CWMP_URL=http://localhost:7547

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-isp-os

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Super Admin Initial Provisioning (Only used on first database seed)
SUPERADMIN_EMAIL=superadmin@ciniplay.in
SUPERADMIN_PASSWORD=change_this_to_a_strong_password
SUPERADMIN_NAME=Super Administrator

# External Integrations (Optional)
WHATSAPP_API_KEY=your_whatsapp_gateway_key_here
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=support@yourdomain.com

# ACS / CWMP Connection Request Authentication (Optional)
CWMP_CONN_REQ_USER=acs_user
CWMP_CONN_REQ_PASS=acs_password
